# Copy to .env for local runs. Never commit .env.
# uvicorn app.main:app --reload --port 8080

# Which end-user issuers this BFF accepts: apple | okta | both
AUTH_ISSUER=both

# Sign in with Apple — iOS bundle id (aud on the identity token)
APPLE_BUNDLE_ID=com.example.yourapp

# Auth0 / Okta CIAM (native public client). Audience is the client id, not a secret.
OKTA_ISSUER=https://YOUR_TENANT.auth0.com/
OKTA_AUDIENCE=YOUR_AUTH0_NATIVE_CLIENT_ID
# Optional override. Auth0 defaults to {issuer}/.well-known/jwks.json
OKTA_JWKS_URL=

# Databricks App this BFF calls server-to-server (Apps HTTPS URL)
DATABRICKS_APP_URL=https://your-app-name.YOUR_REGION.databricksapps.com

# Workspace host for M2M OAuth (no trailing slash required)
DATABRICKS_HOST=https://adb-XXXXXXXXXXXXXXXX.XX.azuredatabricks.net

# This BFF's OWN Databricks service principal (M2M). Needs CAN_USE on the app.
# Not the App's Lakebase SP. Not a personal PAT.
DATABRICKS_SP_CLIENT_ID=
DATABRICKS_SP_CLIENT_SECRET=

# HMAC secret for BFF session JWTs (app/session.py)
# python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=
